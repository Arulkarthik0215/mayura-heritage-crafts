# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mayura_heritage?schema=public"

# JWT
JWT_SECRET="change-this-to-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
FRONTEND_URL="http://localhost:5173"

# AWS S3
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="mayura-heritage-crafts-media"
# Optional: base URL saved for uploaded images (defaults to the bucket's S3 URL)
S3_PUBLIC_URL="https://mayura-heritage-crafts-media.s3.ap-south-1.amazonaws.com"

# Resend (for email notifications)
RESEND_API_KEY="re_xxxxxxxxxxxx"
